# ─────────────────────────────────────────────────────────────
# OtherSide AI — Environment Variables
# Copy this file to `.env.local` for local dev, or set these in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit real keys. This file holds placeholders only.
# ─────────────────────────────────────────────────────────────

# ── AI provider (OpenAI-compatible chat completions endpoint) ──
# Any OpenAI-compatible API works (z.ai GLM, OpenAI, local LM Studio, etc.)
AI_API_BASE_URL=https://api.z.ai/api/coding/paas/v4
AI_MODEL=glm-4.7
OPENAI_API_KEY=your-provider-api-key-here

# ── Live web references (optional but recommended) ──
# Without this key the app still works, but uses curated demo sources
# instead of live search results. Free tier: https://serper.dev
SERPER_API_KEY=your-serper-api-key-here
